{
    "name": "tucano/read-models",
    "description": "MongoDB read model helpers for the Tucano PHP services: schema migrations and version-aware upserts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mongodb": "*",
        "mongodb/mongodb": "^2.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Tucano\\ReadModels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tucano\\ReadModels\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
