{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flaviotinococoutinho/chaos_playground/contracts/events/catalog.product.snapshot.schema.json",
  "title": "tucano.catalog.product.snapshot data",
  "description": "Full state of a published product on the compacted topic catalog.products.v1 (key: productId). Every change of an active or discontinued product sends one; consumers keep the highest version they have seen.",
  "type": "object",
  "required": ["productId", "sku", "name", "status", "category", "price", "weightGrams", "dimensions", "version", "updatedAt"],
  "properties": {
    "productId": {
      "type": "string",
      "description": "UUIDv7 of the product, also the CloudEvent subject and the Kafka key.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": {
      "enum": ["active", "discontinued"],
      "description": "Drafts never leave the catalog."
    },
    "category": {
      "type": "string",
      "description": "Category slug.",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "price": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0, "description": "In the smallest unit of the currency (cents)." },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code." }
      },
      "additionalProperties": false
    },
    "weightGrams": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "dimensions": {
      "type": "object",
      "required": ["lengthMm", "widthMm", "heightMm"],
      "properties": {
        "lengthMm": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "widthMm": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "heightMm": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on every change. A consumer drops a snapshot older than the one it holds."
    },
    "updatedAt": { "type": "string", "format": "date-time", "description": "When the product last changed, in UTC." }
  },
  "additionalProperties": false
}
