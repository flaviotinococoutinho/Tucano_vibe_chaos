{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flaviotinococoutinho/chaos_playground/contracts/events/logistics.shipment.returned.schema.json",
  "title": "tucano.logistics.shipment.returned",
  "description": "The data of a ShipmentReturned: the parcels are back at the fulfillment center. The time is the CloudEvent time.",
  "type": "object",
  "required": ["shipmentId", "trackingCode", "orderId"],
  "properties": {
    "store": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "description": "The slug of the store the fact belongs to (ADR 0031). Optional: a fact from before the stores has none."
    },
    "shipmentId": { "$ref": "#/$defs/uuidv7" },
    "trackingCode": {
      "type": "string",
      "pattern": "^TX[0-9A-HJKMNP-TV-Z]{13}$"
    },
    "orderId": { "$ref": "#/$defs/uuidv7" }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
