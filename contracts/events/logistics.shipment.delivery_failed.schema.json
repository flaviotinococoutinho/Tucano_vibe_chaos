{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flaviotinococoutinho/chaos_playground/contracts/events/logistics.shipment.delivery_failed.schema.json",
  "title": "tucano.logistics.shipment.delivery_failed",
  "description": "The data of a DeliveryAttemptFailed: the visit did not end in a delivery. The time is the CloudEvent time.",
  "type": "object",
  "required": ["shipmentId", "trackingCode", "orderId", "attempt", "reason"],
  "properties": {
    "shipmentId": { "$ref": "#/$defs/uuidv7" },
    "trackingCode": {
      "type": "string",
      "pattern": "^TX[0-9A-HJKMNP-TV-Z]{13}$"
    },
    "orderId": { "$ref": "#/$defs/uuidv7" },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "The visit to the address this event is about, 1 to 3."
    },
    "reason": {
      "enum": ["recipient_absent", "address_not_found", "recipient_refused"]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
