{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flaviotinococoutinho/chaos_playground/contracts/events/logistics.shipment.picked_up.schema.json",
  "title": "tucano.logistics.shipment.picked_up",
  "description": "The data of a ShipmentPickedUp: the carrier collected the parcels at the fulfillment center. The time is the CloudEvent time.",
  "type": "object",
  "required": ["shipmentId", "trackingCode", "orderId"],
  "properties": {
    "shipmentId": { "$ref": "#/$defs/uuidv7" },
    "trackingCode": {
      "type": "string",
      "pattern": "^TX[0-9A-HJKMNP-TV-Z]{13}$"
    },
    "orderId": { "$ref": "#/$defs/uuidv7" }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
