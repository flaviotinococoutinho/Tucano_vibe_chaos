{
  "name": "@tucano/bff",
  "description": "Backend for frontend of the Tucano web app: screens in Siren hypermedia over the catalog, commerce and logistics.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "7.0.2"
  }
}
