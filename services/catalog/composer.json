{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tucano/catalog",
    "type": "project",
    "description": "Catalog service: products and prices, read heavy with cache-aside.",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/php/shared-kernel"
        },
        {
            "type": "path",
            "url": "../../packages/php/feature-flags"
        },
        {
            "type": "path",
            "url": "../../packages/php/messaging"
        }
    ],
    "require": {
        "php": "~8.3.0",
        "illuminate/redis": "^11.0",
        "laravel/lumen-framework": "^11.2",
        "ramsey/uuid": "^4.9",
        "tucano/feature-flags": "*@dev",
        "tucano/messaging": "*@dev",
        "tucano/shared-kernel": "*@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
