# Copy to .env to change what compose reads before it starts the stack. Everything works without it.
# The variables of each service are set in compose.yaml and explained in docs/operations/configuration.md;
# to change one for an experiment, use a compose.override.yaml instead.

# Environment type: local | staging | production. It picks infra/flags/environments/<APP_ENV>.flagd.json
# and is the APP_ENV of every service, so production turns the chaos and lab flags off.
APP_ENV=local
