{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "metadata": { "environment": "staging" },
  "flags": {
    "labs.enabled": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    },
    "chaos.enabled": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off"
    },
    "chaos.commerce.payment-gateway-latency-ms": {
      "state": "ENABLED",
      "variants": { "none": 0, "slow": 800, "very-slow": 3000 },
      "defaultVariant": "none"
    },
    "chaos.commerce.outbox-relay-paused": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off"
    },
    "chaos.commerce.order-projector-paused": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off"
    },
    "chaos.logistics.label-failure-rate": {
      "state": "ENABLED",
      "variants": { "none": 0, "some": 0.2, "most": 0.8 },
      "defaultVariant": "none"
    },
    "chaos.tracking.gps-drop-rate": {
      "state": "ENABLED",
      "variants": { "none": 0, "some": 0.3, "most": 0.9 },
      "defaultVariant": "none"
    },
    "inventory.reservation-strategy": {
      "state": "ENABLED",
      "variants": { "atomic": "atomic", "pessimistic": "pessimistic", "redis": "redis" },
      "defaultVariant": "atomic"
    },
    "logistics.own-fleet-dispatch": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    },
    "checkout.express-shipping": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": { "fractional": [["on", 50], ["off", 50]] }
    },
    "catalog.stock-badge": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    },
    "tracking.live-map": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    }
  }
}
