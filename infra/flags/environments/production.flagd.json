{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "metadata": { "environment": "production" },
  "flags": {
    "inventory.reservation-strategy": {
      "state": "ENABLED",
      "variants": { "atomic": "atomic" },
      "defaultVariant": "atomic"
    },
    "logistics.own-fleet-dispatch": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    },
    "checkout.express-shipping": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": { "fractional": [["on", 10], ["off", 90]] }
    },
    "catalog.stock-badge": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "on"
    },
    "tracking.live-map": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": {
        "if": [{ "ends_with": [{ "var": "email" }, "@tucano.example"] }, "on", "off"]
      }
    }
  }
}
